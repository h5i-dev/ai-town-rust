            then
              if a.dest_x = b.dest_x
              then
                if a.dest_y = b.dest_y
                then
                  if a.pf = b.pf
                  then
                    if a.pf_started = b.pf_started
                    then ok (a.wait_until = b.wait_until)
                    else ok false
                  else ok false
                else ok false
              else ok false
            else ok false
          else ok false
        else ok false
      else ok false
    else ok false
  else ok false

