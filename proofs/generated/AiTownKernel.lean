def rules.dispatch_agent
  (s : Snapshot) («name» : alloc.vec.Vec Std.U8) (character : Std.U32)
  (identity : alloc.vec.Vec Std.U8) (plan : alloc.vec.Vec Std.U8)
  (now : Std.U64) :
  Result ((core.result.Result Reply Error) × Snapshot)
  := do
  let r ← rules.require_world s
  match r with
  | core.result.Result.Ok _ =>
    let b ← rules.text_ok «name» MAX_NAME
    if b
    then
      if character >= 8#u32
      then ok (core.result.Result.Err Error.BadText, s)
      else
        let b1 ← rules.text_ok identity MAX_PLAN
        if b1
        then
          let b2 ← rules.text_ok plan MAX_PLAN
          if b2
          then
            let (r1, s1) ← rules.alloc s
            match r1 with
            | core.result.Result.Ok v =>
              let o ← rules.spawn_at s1 v
              match o with
              | none => ok (core.result.Result.Err Error.Occupied, s1)
              | some p =>
                let (x, y) := p
                let (fdx, fdy) ← rules.face_salt v
                let owner ← AGENT_BASE + v
                let v1 ← alloc.vec.CloneVec.clone core.clone.CloneU8 «name»
                let v2 ←
                  alloc.vec.Vec.push s1.players
                    ({
                       id := v,
                       owner,
                       is_human := false,
                       x,
                       y,
                       face_dx := fdx,
                       face_dy := fdy,
                       speed := 0#u32,
                       dest_x := 0#u32,
                       dest_y := 0#u32,
                       pf := PF_NONE,
                       pf_started := now,
                       wait_until := 0#u64,
                       last_input := now,
                       activity := 0#u32,
                       activity_until := 0#u64,
                       character,
                       «name» := v1
                     } : Player)
                let (r2, s2) ← rules.alloc { s1 with players := v2 }
                match r2 with
                | core.result.Result.Ok v3 =>
                  let v4 ←
                    alloc.vec.CloneVec.clone core.clone.CloneU8 identity
                  let v5 ← alloc.vec.CloneVec.clone core.clone.CloneU8 plan
                  let v6 ←
                    alloc.vec.Vec.push s2.agents
                      ({
                         id := v3,
                         player := v,
                         owner,
                         to_remember := 0#u64,
                         last_conversation := 0#u64,
                         last_invite := 0#u64,
                         op := OP_NONE,
                         op_since := 0#u64,
                         op_arg := 0#u64,
                         character,
                         «name» := v1,
                         identity := v4,
                         plan := v5
                       } : Agent)
                  ok (core.result.Result.Ok (Reply.Player v),
                    { s2 with agents := v6 })
                | core.result.Result.Err e => ok (core.result.Result.Err e, s2)
            | core.result.Result.Err e => ok (core.result.Result.Err e, s1)
          else ok (core.result.Result.Err Error.BadText, s)
        else ok (core.result.Result.Err Error.BadText, s)
    else ok (core.result.Result.Err Error.BadText, s)
  | core.result.Result.Err e => ok (core.result.Result.Err e, s)

/-- [ai_town_kernel::rules::dispatch_init]:
    Source: 'kernel/src/rules.rs', lines 1076:0-1093:1 -/
def rules.dispatch_init
  (s : Snapshot) (width : Std.U32) (height : Std.U32)
  (mask : alloc.vec.Vec Std.U8) (now : Std.U64) :
  Result ((core.result.Result Reply Error) × Snapshot)
  := do
  if s.meta.width != 0#u32
  then ok (core.result.Result.Err Error.Already, s)
  else
    if width = 0#u32
    then ok (core.result.Result.Err Error.BadState, s)
    else
      if height = 0#u32
      then ok (core.result.Result.Err Error.BadState, s)
      else
        if width > MAX_DIM
        then ok (core.result.Result.Err Error.BadState, s)
        else
          if height > MAX_DIM
          then ok (core.result.Result.Err Error.BadState, s)
          else
            let i ← lift (UScalar.cast .Usize width)
            let i1 ← lift (UScalar.cast .Usize height)
            let cells ← i * i1
            let i2 := alloc.vec.Vec.len mask
            let i3 ← geom.mask_bytes cells
            if i2 != i3
            then ok (core.result.Result.Err Error.BadState, s)
            else
              let v ← alloc.vec.CloneVec.clone core.clone.CloneU8 mask
              ok (core.result.Result.Ok Reply.Ok,
                {
                  s
                    with
                    «meta» :=
                      {
                        s.meta
                          with
                          next_id := 1#u64, now_ms := now, width, height
                      },
                    terrain := { mask := v }
                })

