def decode (r : Rows) : Result (Option Snapshot) := do
  let o ← Meta.from_one r.meta
  match o with
  | none => ok none
  | some x =>
    let o1 ← Terrain.from_one r.terrain
    match o1 with
    | none => ok none
    | some x1 =>
      let o2 ← Player.from_rows r.players
      match o2 with
      | none => ok none
      | some x2 =>
        let o3 ← PathNode.from_rows r.paths
        match o3 with
        | none => ok none
        | some x3 =>
          let o4 ← Conversation.from_rows r.conversations
          match o4 with
          | none => ok none
          | some x4 =>
            let o5 ← Member.from_rows r.members
            match o5 with
            | none => ok none
            | some x5 =>
              let o6 ← Agent.from_rows r.agents
              match o6 with
              | none => ok none
              | some x6 =>
                let o7 ← Memory.from_rows r.memories
                match o7 with
                | none => ok none
                | some x7 =>
                  let o8 ← Message.from_rows r.messages
                  match o8 with
                  | none => ok none
                  | some x8 =>
                    ok (some
                      {
                        «meta» := x,
                        terrain := x1,
                        players := x2,
                        paths := x3,
                        conversations := x4,
                        members := x5,
                        agents := x6,
                        memories := x7,
                        messages := x8
                      })

