def Agent.putA (x : Agent) : AWrite Val := .put Agent.table Agent.keyLen (Agent.row x)

@[step] theorem Agent.sql_put_spec (x : Agent) : Agent.sql_put x ⦃ w => sqlW w = Agent.putA x ⦄ := by
  unfold Agent.sql_put; step*; simp_all [sqlW, Agent.putA, Agent.table, Agent.keyLen, Agent.TABLE, Agent.KEY_LEN]

/-- Insert, or replace the row with the same key. -/
@[step] theorem Agent.put_spec (v : alloc.vec.Vec Agent) (x : Agent) (h : v.length < Usize.max) :
    Agent.put v x ⦃ v' => v'.val = upsert (fun y => y.id) x v.val ⦄ := by
  unfold Agent.put Agent.put_loop
  apply WP.spec_mono (loop_search v.val (fun q => decide (q.id = x.id))
    (fun y : alloc.vec.Vec Agent => y.val) (fun j _ => v.val.set j x) (v.val ++ [x]) _ ?_ 0#usize (by simp))
  · intro r hr; rw [hr, show ((0#usize : Usize) : Nat) = 0 from rfl]
    exact upsert_loop_result (fun y => y.id) x _ 0 (Nat.zero_le _) (by simp)
  · intro j hj; unfold Agent.put_loop.body; h5i_step

/-- The rows without this key. -/
@[step] theorem Agent.del_spec (v : alloc.vec.Vec Agent) (id : U64) :
    Agent.del v id ⦃ v' => v'.val = v.val.filter (fun y => ¬(y.id = id)) ⦄ := by
  unfold Agent.del Agent.del_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Agent => w.val)
    (fun acc y => if decide ¬(y.id = id) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Agent.del_loop.body v id x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Agent.del_loop.body; h5i_step

/-- The rows whose column `col` does not hold `val`. -/
@[step] theorem Agent.del_where_spec (v : alloc.vec.Vec Agent) (col : U32) (val : Val) :
    Agent.del_where v col val ⦃ v' => v'.val = v.val.filter (fun y => ¬((Agent.row y)[col.val]? = some val)) ⦄ := by
  unfold Agent.del_where Agent.del_where_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Agent => w.val)
    (fun acc y => if decide ¬((Agent.row y)[col.val]? = some val) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Agent.del_where_loop.body v col val x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Agent.del_where_loop.body; h5i_step

def Agent.delA (id : U64) : AWrite Val := .del Agent.table [int id.val]
def Agent.delWhereA (col : Nat) (val : Val) : AWrite Val := .delWhere Agent.table col val

@[step] theorem Agent.sql_del_spec (id : U64) : Agent.sql_del id ⦃ w => sqlW w = Agent.delA id ⦄ := by
  unfold Agent.sql_del; step* <;> simp_all [sqlW, Agent.delA, Agent.table, Agent.TABLE] <;> scalar_tac

@[step] theorem Agent.sql_del_where_spec (col : U32) (val : Val) :
    Agent.sql_del_where col val ⦃ w => sqlW w = Agent.delWhereA col.val val ⦄ := by
  unfold Agent.sql_del_where; simp [sqlW, Agent.delWhereA, Agent.table, Agent.TABLE]

/-! Row writes on the encoding match the list operations. -/

@[simp] theorem Agent.map_put (x : Agent) (l : List Agent) :
    upsert (·.take 1) (Agent.row x) (l.map Agent.row) = (upsert (fun y => y.id) x l).map Agent.row :=
  map_upsert _ _ _ _ _ (fun y => by simp [Agent.row])

@[simp] theorem Agent.map_del (id : U64) (l : List Agent) :
    (l.map Agent.row).filter (fun r => !decide (r.take 1 = [int id.val])) =
      (l.filter (fun y => !decide (y.id = id))).map Agent.row :=
  map_filter_of _ _ _ _ (fun y => by simp [Agent.row])

@[simp] theorem Agent.map_del_where (col : Nat) (val : Val) (l : List Agent) :
    (l.map Agent.row).filter (fun r => !decide (r[col]? = some val)) =
      (l.filter (fun y => !decide ((Agent.row y)[col]? = some val))).map Agent.row := by
  rw [List.filter_map]; rfl

