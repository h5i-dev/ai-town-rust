    let b ← geom.mask_blocked s i i1 x y
    let blocked ←
      if b
      then ok true
      else
        let s1 := alloc.vec.Vec.deref xs
        let s2 := alloc.vec.Vec.deref ys
        geom.near_hit near s1 s2 x y core.num.U32.MAX
    if blocked
    then let k1 ← k + 1#u64
         ok (cont k1)
