def geom.grid_yield
  (width : Std.U32) (height : Std.U32) (head : Slice Std.U32)
  (next : Slice Std.U32) (xs : Slice Std.U32) (ys : Slice Std.U32)
  (ids : Slice Std.U64) (x : Std.U32) (y : Std.U32) (self_id : Std.U64)
  (skip : Std.U32) :
  Result Bool
  := do
  if width = 0#u32
  then ok false
  else
    if height = 0#u32
    then ok false
    else
      let cx ← x / MILLI
      let cy ← y / MILLI
      if cx >= width
      then ok false
      else
        if cy >= height
        then ok false
        else
          let tx ← if cx = 0#u32
                     then ok 0#u32
                     else cx - 1#u32
          let y0 ← if cy = 0#u32
                     then ok 0#u32
                     else cy - 1#u32
          let i ← cx + 1#u32
          let x1 ← if i >= width
                     then width - 1#u32
                     else ok i
          let i1 ← cy + 1#u32
          let y1 ← if i1 >= height
                     then height - 1#u32
                     else ok i1
          geom.grid_yield_loop0 height head next xs ys ids x y self_id skip y0
            x1 y1 false tx

