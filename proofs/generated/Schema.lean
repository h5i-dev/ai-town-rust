theorem Player.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Player)
    (h : rows.val.map (·.val) = l.map Player.row) :
    Player.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Player.from_rows_loop rows (alloc.vec.Vec.new Player) true 0#usize =
      loop (fun x => rowsBody Player.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Player, true, 0#usize) := by
    unfold Player.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Player.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Player.from_rows_loop rows (alloc.vec.Vec.new Player) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Player.from_row Player.row (fun x v hv => Player.from_row_spec x v hv) rows l h
  unfold Player.from_rows
  step with hl
  simp [ok1_post, l_post]

