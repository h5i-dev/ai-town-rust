  (s : Snapshot) (salt : Std.U64) : Result (Option (Std.U32 × Std.U32)) := do
  let w ← lift (UScalar.cast .U64 s.meta.width)
  let h ← lift (UScalar.cast .U64 s.meta.height)
  if w = 0#u64
  then ok none
  else
    if h = 0#u64
    then ok none
    else
      let (xs, ys) ←
        rules.spawn_at_loop0 s.players (alloc.vec.Vec.new Std.U32)
          (alloc.vec.Vec.new Std.U32) 0#usize
      let s1 := alloc.vec.Vec.deref xs
      let s2 := alloc.vec.Vec.deref ys
      let near ← geom.near_index s.meta.width s.meta.height s1 s2
      let n ← w * h
      rules.spawn_at_loop1 s.meta.width s.meta.height s.terrain salt h xs ys
        near n 0#u64

/-- [ai_town_kernel::rules::dispatch_join]:
    Source: 'kernel/src/rules.rs', lines 1157:0-1197:1 -/
def rules.dispatch_join
  (s : Snapshot) (owner : Std.U64) («name» : alloc.vec.Vec Std.U8)
  (character : Std.U32) (now : Std.U64) :
  Result ((core.result.Result Reply Error) × Snapshot)
  := do
  let r ← rules.require_world s
  match r with
  | core.result.Result.Ok _ =>
    if owner = ENGINE
    then ok (core.result.Result.Err Error.Forbidden, s)
    else
      if owner >= AGENT_BASE
      then ok (core.result.Result.Err Error.Forbidden, s)
      else
        let o ← rules.player_by_owner s.players owner
        let b := core.option.Option.is_some o
        if b
        then ok (core.result.Result.Err Error.Already, s)
        else
          let i ← rules.human_count s
          if i >= MAX_HUMANS
          then ok (core.result.Result.Err Error.Full, s)
          else
            let b1 ← rules.text_ok «name» MAX_NAME
            if b1
            then
              if character >= 8#u32
              then ok (core.result.Result.Err Error.BadText, s)
              else
                let (r1, s1) ← rules.alloc s
                match r1 with
                | core.result.Result.Ok v =>
                  let o1 ← rules.spawn_at s1 owner
                  match o1 with
                  | none => ok (core.result.Result.Err Error.Occupied, s1)
                  | some p =>
                    let (x, y) := p
                    let (fdx, fdy) ← rules.face_salt owner
                    let v1 ←
                      alloc.vec.CloneVec.clone core.clone.CloneU8 «name»
                    let v2 ←
                      alloc.vec.Vec.push s1.players
                        ({
                           id := v,
                           owner,
                           is_human := true,
                           x,
                           y,
                           face_dx := fdx,
                           face_dy := fdy,
                           speed := 0#u32,
                           dest_x := 0#u32,
                           dest_y := 0#u32,
                           pf := PF_NONE,
                           pf_started := now,
                           wait_until := 0#u64,
                           last_input := now,
                           activity := 0#u32,
                           activity_until := 0#u64,
                           character,
                           «name» := v1
                         } : Player)
                    ok (core.result.Result.Ok (Reply.Player v),
                      { s1 with players := v2 })
                | core.result.Result.Err e => ok (core.result.Result.Err e, s1)
            else ok (core.result.Result.Err Error.BadText, s)
  | core.result.Result.Err e => ok (core.result.Result.Err e, s)

/-- [ai_town_kernel::rules::dispatch_agent]:
