  let i2 ← i + i1
  let len ← geom.isqrt i2
  if len = 0#u64
  then let i3 ← geom.face_zero
       ok (i3, i3)
  else
    let i3 ← dx * 1000#u64
    let i4 ← i3 / len
    let mx ← lift (UScalar.cast .U32 i4)
    let i5 ← dy * 1000#u64
    let i6 ← i5 / len
    let my ← lift (UScalar.cast .U32 i6)
    let fdx ← if bx >= ax
                then FACE_BIAS + mx
                else FACE_BIAS - mx
    if «by» >= ay
    then let fdy ← FACE_BIAS + my
         ok (fdx, fdy)
    else let fdy ← FACE_BIAS - my
         ok (fdx, fdy)

